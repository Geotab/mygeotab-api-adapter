################################################################################
# .gitignore for the MyGeotab API Adapter solution.
#
# Uses standard, GLOBAL (project-agnostic) rules so build output and per-user
# files are ignored in every project — current and future — with no per-project
# entries to maintain. (This file previously listed bin/obj per project, which
# had to be updated for every new project and was easy to miss on merges.)
#
# Anything below the "Repo-specific" divider is an intentional ignore that the
# standard rules above do not cover. Keep those; do not fold them away.
################################################################################

# Build output (any project, configuration, or target framework)
[Bb]in/
[Oo]bj/

# Visual Studio working folder, per-user and cache files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Logs
*.log

# =============================================================================
# Repo-specific ignores (not covered by the standard rules above)
# =============================================================================

# Environment-specific developer configuration — never committed.
# appsettings.Development.json recurs in every service project, so it is global;
# devices.Development.json exists only in the SolEng feeder, so it stays explicit.
appsettings.Development.json

# Local-only documentation staging folder
/DocsForLLMs

# Claude Code local settings
/.claude/

# VS 2022 bug: creates a literal 'nul' file instead of writing to the null device
nul

# macOS Finder metadata
.DS_Store
